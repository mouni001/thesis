        <mxCell id="p_bank" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#333333;strokeWidth=2;shadow=1;fontSize=14" value="Prototype Bank Entry&lt;br&gt;&lt;b&gt;p = {vec, label, space, last_step, rep, drift, minority}&lt;/b&gt;&lt;br&gt;vec = latent prototype center&lt;br&gt;space = S1 or S2" vertex="1">
          <mxGeometry height="120" width="390" x="550" y="205" as="geometry" />
        </mxCell>
        <mxCell id="p_update_rules" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#333333;strokeWidth=2;shadow=1;fontSize=14" value="Prototype Update Rules&lt;br&gt;If correct and near same-class prototype:&lt;br&gt;&lt;b&gt;refresh prototype center&lt;/b&gt;&lt;br&gt;If mistake, drift signal, or no same-class prototype:&lt;br&gt;&lt;b&gt;add potential/new prototype&lt;/b&gt;" vertex="1">
          <mxGeometry height="135" width="390" x="550" y="380" as="geometry" />
        </mxCell>
        <mxCell id="p_quality" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#333333;strokeWidth=2;shadow=1;fontSize=14;fontStyle=1" value="Quality Score&lt;br&gt;&lt;b&gt;Q(p)=A(p) × O(p)^w_o × F(p)^w_f&lt;/b&gt;&lt;br&gt;A(p): normalized weighted average&lt;br&gt;rep, drift, minority, uncertainty&lt;br&gt;O(p): old-space obsolescence&lt;br&gt;F(p): freshness / age decay" vertex="1">
          <mxGeometry height="165" width="390" x="550" y="575" as="geometry" />
        </mxCell>
        <mxCell id="p_proto_expert" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B9F6CA;strokeColor=#333333;strokeWidth=2;shadow=1;fontSize=15;fontStyle=1" value="Prototype Expert&lt;br&gt;&lt;b&gt;Expert E3&lt;/b&gt;&lt;br&gt;nearest prototypes vote by class&lt;br&gt;score += Q(p)/(distance + ε)" vertex="1">

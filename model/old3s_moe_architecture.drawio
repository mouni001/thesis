          <mxGeometry height="105" width="230" x="110" y="390" as="geometry" />
        </mxCell>
        <mxCell id="p_pred" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C9DAF8;strokeColor=#333333;strokeWidth=2;shadow=1;fontSize=15" value="Prediction result&lt;br&gt;&lt;b&gt;y_hat vs y_t&lt;/b&gt;&lt;br&gt;correct or mistake" vertex="1">

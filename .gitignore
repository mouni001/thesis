# Python caches and virtual environments
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/
.env
.env.*
!.env.example

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local datasets and experiment results
/data/
/model/data/*
/model/analysis/data/
.matplotlib_cache/

# Saved models and runtime logs
*.pth
*.pt
*.pkl
*.npz
*.log

# Reference papers and local archives
/papers/
/*.pdf
*.zip
**/source_snapshot/

# Generated thesis typesetting files
*.tex
*.bib
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.out
*.run.xml
*.synctex.gz
*.toc

# OLD3S baseline dependencies
/external/*
!/external/OLD3S_official/
/external/OLD3S_official/*
!/external/OLD3S_official/LICENSE
!/external/OLD3S_official/README.md
!/external/OLD3S_official/model/
/external/OLD3S_official/model/*
!/external/OLD3S_official/model/autoencoder.py
!/external/OLD3S_official/model/mlp.py
!/external/OLD3S_official/model/model.py

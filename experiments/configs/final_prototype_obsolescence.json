{
  "name": "final_prototype_obsolescence_v7",
  "description": "Protocol-v7 low-overlap contraction stress test of feature obsolescence, age decay, and prototype removal on the held-out source region.",
  "reference_experiment": "full_decay",
  "base_args": {
    "DataName": "insects",
    "insects_csv": "data/INSECTS_incremental_balanced.csv",
    "feature_protocol": "feature_evolution",
    "feature_scenario": "s2_contracts",
    "shared_frac": 0.25,
    "split_index": 45000,
    "T1": 1500,
    "t": 1000,
    "eval_window": 250,
    "prototype_bank_size": 512,
    "detector_type": "adwin",
    "diagnostic_interval": 25,
    "run_sanity_baselines": 0
  },
  "seeds": [11, 17, 23, 31, 43],
  "experiments": [
    {"name": "full_decay", "args": {}},
    {"name": "no_feature_obsolescence", "args": {"prototype_obsolescence_weight": 0.0}},
    {"name": "no_age_decay", "args": {"prototype_freshness_weight": 0.0}},
    {"name": "no_prototype_memory", "args": {"use_prototype_memory": 0}}
  ]
}

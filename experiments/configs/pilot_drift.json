{
  "name": "pilot_drift_v4",
  "description": "Protocol-v6 detector and drift-relevance pilot around an annotated abrupt INSECTS change.",
  "seeds": [17],
  "base_args": {
    "DataName": "insects",
    "insects_csv": "data/INSECTS_abrupt_balanced.csv",
    "feature_protocol": "feature_evolution",
    "split_index": 13852,
    "T1": 1500,
    "t": 1000,
    "eval_window": 100,
    "RecLossFunc": "mse"
  },
  "experiments": [
    {"name": "adwin_with_drift_relevance", "args": {"detector_type": "adwin"}},
    {"name": "adwin_without_drift_relevance", "args": {"detector_type": "adwin", "prototype_drift_weight": 0.0}},
    {"name": "mddm_g_with_drift_relevance", "args": {"detector_type": "mddm_g"}},
    {"name": "mddm_g_without_drift_relevance", "args": {"detector_type": "mddm_g", "prototype_drift_weight": 0.0}}
  ]
}

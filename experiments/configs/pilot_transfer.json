{
  "name": "pilot_transfer_v4",
  "description": "Protocol-v5 development pilot comparing identity-safe residual mapping, legacy random MLP mapping, no mapper, and no historical knowledge.",
  "seeds": [17],
  "base_args": {
    "DataName": "insects",
    "insects_csv": "data/INSECTS_incremental_balanced.csv",
    "feature_protocol": "feature_evolution",
    "feature_scenario": "balanced",
    "split_index": 35000,
    "T1": 500,
    "t": 200,
    "eval_window": 100,
    "detector_type": "adwin",
    "RecLossFunc": "mse"
  },
  "experiments": [
    {"name": "residual_transfer", "args": {"transfer_mapper_mode": "residual"}},
    {"name": "legacy_mlp_transfer", "args": {"transfer_mapper_mode": "mlp"}},
    {"name": "no_transfer_mapper", "args": {"use_transfer_mapper": 0}},
    {"name": "no_historical_knowledge", "args": {"use_historical_knowledge": 0}}
  ]
}

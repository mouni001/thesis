{
  "name": "final_main_v7",
  "description": "Held-out protocol-v7 principal comparison with ten paired seeds and distinct feature-transition phases.",
  "reference_experiment": "full_model",
  "base_args": {
    "DataName": "insects",
    "insects_csv": "data/INSECTS_incremental_balanced.csv",
    "feature_protocol": "feature_evolution",
    "feature_scenario": "balanced",
    "split_index": 45000,
    "T1": 1500,
    "t": 1000,
    "eval_window": 250,
    "detector_type": "adwin",
    "RecLossFunc": "mse",
    "diagnostic_interval": 25,
    "run_sanity_baselines": 0
  },
  "seeds": [11, 17, 23, 31, 43, 59, 71, 83, 97, 109],
  "experiments": [
    {"name": "full_model", "args": {}},
    {"name": "no_transfer_mapper", "args": {"use_transfer_mapper": 0}},
    {"name": "no_historical_knowledge", "args": {"use_historical_knowledge": 0}},
    {"name": "no_prototype_memory", "args": {"use_prototype_memory": 0}},
    {"name": "fixed_fusion", "args": {"fusion_mode": "fixed"}},
    {"name": "no_historical_expert", "args": {"enable_historical_expert": 0}},
    {"name": "no_adaptive_expert", "args": {"enable_adaptive_expert": 0}},
    {"name": "no_prototype_expert", "args": {"enable_prototype_expert": 0}},
    {
      "name": "single_adaptive_cold_start",
      "args": {
        "use_historical_knowledge": 0,
        "use_prototype_memory": 0,
        "fusion_mode": "fixed",
        "enable_historical_expert": 0,
        "enable_prototype_expert": 0
      }
    },
    {
      "name": "old3s_style_fixed_two_expert",
      "args": {
        "use_prototype_memory": 0,
        "fusion_mode": "fixed",
        "enable_prototype_expert": 0
      }
    },
    {"name": "hoeffding_tree", "kind": "river", "method": "hoeffding_tree", "args": {}},
    {"name": "hoeffding_adaptive_tree", "kind": "river", "method": "hoeffding_adaptive_tree", "args": {}},
    {"name": "adaptive_random_forest", "kind": "river", "method": "adaptive_random_forest", "args": {}},
    {"name": "gaussian_naive_bayes", "kind": "river", "method": "gaussian_naive_bayes", "args": {}}
  ]
}

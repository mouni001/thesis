{
  "name": "pilot_core_v6",
  "description": "Protocol-v6 structural baselines and expert/MoE ablations with identity-safe transfer and uniform router initialization.",
  "seeds": [17],
  "base_args": {
    "DataName": "insects",
    "insects_csv": "data/INSECTS_incremental_balanced.csv",
    "feature_protocol": "feature_evolution",
    "feature_scenario": "balanced",
    "split_index": 35000,
    "T1": 500,
    "t": 200,
    "eval_window": 100,
    "detector_type": "adwin",
    "RecLossFunc": "mse"
  },
  "experiments": [
    {"name": "full_model", "args": {}},
    {"name": "no_transfer", "args": {"use_transfer_mapper": 0}},
    {"name": "no_history", "args": {"use_historical_knowledge": 0}},
    {"name": "no_prototypes", "args": {"use_prototype_memory": 0}},
    {"name": "fixed_fusion", "args": {"fusion_mode": "fixed"}},
    {
      "name": "single_adaptive_cold_start",
      "args": {
        "use_historical_knowledge": 0,
        "use_prototype_memory": 0,
        "fusion_mode": "fixed",
        "enable_historical_expert": 0,
        "enable_prototype_expert": 0
      }
    },
    {
      "name": "single_adaptive_transferred",
      "args": {
        "use_prototype_memory": 0,
        "fusion_mode": "fixed",
        "enable_historical_expert": 0,
        "enable_prototype_expert": 0
      }
    },
    {
      "name": "old3s_style_fixed_two_expert",
      "args": {
        "use_prototype_memory": 0,
        "fusion_mode": "fixed",
        "enable_prototype_expert": 0
      }
    },
    {"name": "without_historical_expert", "args": {"enable_historical_expert": 0}},
    {"name": "without_adaptive_expert", "args": {"enable_adaptive_expert": 0}},
    {"name": "without_prototype_expert", "args": {"enable_prototype_expert": 0}}
  ]
}

{
  "name": "final_class_imbalance_v7",
  "description": "Protocol-v7 minority-weighting comparison on incremental and gradual naturally imbalanced INSECTS streams.",
  "reference_experiment": "incremental_weighting_on",
  "base_args": {
    "DataName": "insects",
    "feature_protocol": "feature_evolution",
    "feature_scenario": "balanced",
    "T1": 1500,
    "t": 1000,
    "eval_window": 250,
    "detector_type": "adwin",
    "diagnostic_interval": 25,
    "run_sanity_baselines": 0
  },
  "seeds": [11, 17, 23, 31, 43],
  "experiments": [
    {"name": "incremental_weighting_on", "args": {"insects_csv": "data/INSECTS_incremental_imbalanced.csv", "split_index": 400000, "prototype_minority_weight": 0.5}},
    {"name": "incremental_weighting_off", "args": {"insects_csv": "data/INSECTS_incremental_imbalanced.csv", "split_index": 400000, "prototype_minority_weight": 0.0}},
    {"name": "gradual_weighting_on", "args": {"insects_csv": "data/INSECTS_gradual_imbalanced.csv", "split_index": 120000, "prototype_minority_weight": 0.5}},
    {"name": "gradual_weighting_off", "args": {"insects_csv": "data/INSECTS_gradual_imbalanced.csv", "split_index": 120000, "prototype_minority_weight": 0.0}}
  ]
}

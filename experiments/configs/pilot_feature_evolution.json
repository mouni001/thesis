{
  "name": "pilot_feature_evolution_v1",
  "description": "Protocol-v4 predictive and latent-alignment validation across balanced, expanding, and contracting unequal feature spaces.",
  "base_args": {
    "DataName": "insects",
    "insects_csv": "data/INSECTS_incremental_balanced.csv",
    "feature_protocol": "feature_evolution",
    "shared_frac": 0.5,
    "split_index": 35000,
    "T1": 500,
    "t": 200,
    "eval_window": 100,
    "detector_type": "adwin",
    "RecLossFunc": "mse",
    "diagnostic_interval": 10
  },
  "seeds": [17],
  "experiments": [
    {"name": "balanced_mapper", "args": {"feature_scenario": "balanced"}},
    {"name": "balanced_no_mapper", "args": {"feature_scenario": "balanced", "use_transfer_mapper": 0}},
    {"name": "s2_expands_mapper", "args": {"feature_scenario": "s2_expands"}},
    {"name": "s2_expands_no_mapper", "args": {"feature_scenario": "s2_expands", "use_transfer_mapper": 0}},
    {"name": "s2_contracts_mapper", "args": {"feature_scenario": "s2_contracts"}},
    {"name": "s2_contracts_no_mapper", "args": {"feature_scenario": "s2_contracts", "use_transfer_mapper": 0}}
  ]
}

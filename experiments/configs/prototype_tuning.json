{
  "name": "prototype_tuning_development_v2",
  "description": "Development-only grid search of prototype neighbors and refresh rate; select highest mean S2 prequential accuracy across three seeds. Not untouched final evaluation.",
  "selection": {
    "metric": "mean of correct over S2, then mean across seeds",
    "tie_break": "prefer default k=5, merge_alpha=0.2, then smaller k, then smaller merge_alpha",
    "scope": "INSECTS incremental balanced development window only"
  },
  "reference_experiment": "k5_merge020",
  "base_args": {
    "DataName": "insects",
    "insects_csv": "data/INSECTS_incremental_balanced.csv",
    "feature_protocol": "feature_evolution",
    "feature_scenario": "balanced",
    "split_index": 35000,
    "T1": 1000,
    "t": 750,
    "eval_window": 125,
    "detector_type": "adwin",
    "RecLossFunc": "mse",
    "diagnostic_interval": 25,
    "shared_frac": 0.5
  },
  "seeds": [
    11,
    17,
    23
  ],
  "experiments": [

{
  "name": "pilot_class_imbalance_v3",
  "description": "Matched pilot of prototype minority weighting on two naturally imbalanced INSECTS streams. Minority identity is frozen from S1 only.",
  "base_args": {
    "DataName": "insects",
    "feature_protocol": "feature_evolution",
    "feature_scenario": "balanced",
    "T1": 800,
    "t": 400,
    "eval_window": 150,
    "detector_type": "adwin",
    "diagnostic_interval": 10,
    "run_sanity_baselines": 0
  },
  "seeds": [17],
  "experiments": [
    {
      "name": "incremental_weighting_on",
      "args": {
        "insects_csv": "data/INSECTS_incremental_imbalanced.csv",
        "prototype_minority_weight": 0.5
      }
    },
    {
      "name": "incremental_weighting_off",
      "args": {
        "insects_csv": "data/INSECTS_incremental_imbalanced.csv",
        "prototype_minority_weight": 0.0
      }
    },
    {
      "name": "gradual_weighting_on",
      "args": {
        "insects_csv": "data/INSECTS_gradual_imbalanced.csv",
        "prototype_minority_weight": 0.5
      }
    },
    {
      "name": "gradual_weighting_off",
      "args": {
        "insects_csv": "data/INSECTS_gradual_imbalanced.csv",
        "prototype_minority_weight": 0.0
      }
    }
  ]
}
